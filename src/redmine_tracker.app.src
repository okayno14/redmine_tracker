{application, redmine_tracker,
 [{description, "An OTP application"},
  {vsn, "0.1.0"},
  {registered, []},
  {mod, {redmine_tracker_app, []}},
  {applications,
   [kernel,
    stdlib,
    ssl,
    inets,
    erl_utils,
    xmerl
   ]},
  {included_applications, [
    mnesia
  ]},
  {env,[
    {db_path, <<"~/.local/state/redmine_tracker/mnesia">>},
    {socket, <<"$XDG_RUNTIME_DIR/redmine_tracker.sock">>}
    {api_key, <<"1234">>},
    {user_id, 1234},
    {redmine_instance, <<"https://redmine.org">>},
    {activities, #{
    }}
  ]},
  {modules, [
  ]},

  {licenses, ["Apache 2.0"]},
  {links, []}
 ]}.
