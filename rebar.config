{erl_opts, [debug_info]}.

{deps, [
    {meck, {git, "https://github.com/eproxus/meck.git", {tag, "v1.1.0"}}},
    {erl_utils, {git, "https://github.com/okayno14/erl_utils.git", {branch, "v2"}}}
    % {observer_cli, {git, "https://github.com/zhongwencool/observer_cli.git", {tag, "1.8.7"}}}
]}.

{shell, [
  {config, "config/sys.config"},
  {apps, [redmine_tracker]}
]}.

{escript_incl_apps, [erl_utils, redmine_tracker]}.
{escript_name, redmine_tracker_ctl}.
{escript_emu_args, "%%! +sbtu +A1\n"}.

{provider_hooks, [{post, [{compile, escriptize}]}]}.

{relx, [
  {release, {redmine_tracker, "0.0.1"}, [redmine_tracker]}
]}.

{profiles, [
  {test, [
    % {ct_opts, [{sys_config, "config/test.config"}]},
    {eunit_opts, [{sys_config, "config/sys.config"}]}
  ]},
  {prod, [
    {relx, [
      {mode, prod},
      {overlay, [
        {copy, "{{root_dir}}/priv/redmine_tracker_startup", "{{output_dir}}/bin/redmine_tracker_startup"},
        % for nix build: it stores only output_dir
        {copy, "{{root_dir}}/_build/prod/bin/redmine_tracker_ctl", "{{output_dir}}/bin/redmine_tracker_ctl"}
      ]}
    ]}
  ]},
  {dev, [
    {relx, [
      {mode, dev},
      {overlay, [
        {copy, "{{root_dir}}/priv/redmine_tracker_startup", "{{output_dir}}/bin/redmine_tracker_startup"}
      ]}
    ]}
  ]}
]}.
